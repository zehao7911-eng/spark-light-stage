function resolve(){const v=state.values,counts=v.map(x=>v.filter(y=>y===x).length),max=Math.max(...counts),dominant=v[counts.indexOf(max)],unique=new Set(v).size,allStar=v.every(x=>x===1);let mult=max===3?(allStar?12:5):max===2?2:.5;let reward=Math.round(state.stake*mult*(state.rush?1.5:1));const wished=v.includes(state.wish);if(wished){reward+=15;state.wish=(state.wish+1+Math.floor(Math.random()*4))%5}state.wallet+=reward;state.brews++;state.best=Math.max(state.best,reward);let id=unique===3?'trio-'+dominant:max===3?'triple-'+dominant:'pair-'+dominant;const newlyFound=!state.collection.has(id);state.collection.add(id);const name=max===3?(allStar?'Golden Glim':ING[dominant].creature):max===2?ING[dominant].creature:'Rainbow Sprout';el.creature.style.background=`radial-gradient(circle at 30% 20%,#fff8dc,${ING[dominant].light} 30%,${ING[dominant].color} 80%)`;el.creature.classList.add('show');machine.classList.remove('pulse');void machine.offsetWidth;machine.classList.add('pulse');el.headline.textContent=max===3?'MAGICAL MATCH!':max===2?'SWEET PAIR!':'A NEW LITTLE FRIEND';el.resultName.textContent=name;el.resultReward.textContent=`+${reward} STARS${wished?' · WISH +15':''}`;say(newlyFound?'New friend!':max===3?'So magical!':wished?'Wish granted!':max===2?'A sweet surprise!':'Hello, little one!');burst(max===3||state.rush);chime();if(navigator.vibrate)navigator.vibrate(max===3?[25,45,55]:30);state.phase='idle';state.rush=false;save();render()}
function showAlbum(){if(state.phase!=='idle')return;el.albumGrid.replaceChildren();for(const type of ['trio','pair','triple'])for(let i=0;i<5;i++){const found=state.collection.has(`${type}-${i}`),card=document.createElement('div'),symbol=document.createElement('b'),label=document.createElement('small');card.className='album-stamp'+(found?' found':'');symbol.textContent=found?ING[i].glyph:'?';symbol.style.color=found?ING[i].color:'#bc9c85';label.textContent=found?(type==='trio'?'RAINBOW':type==='pair'?'SWEET':'MAGIC'):'LOCKED';card.append(symbol,label);el.albumGrid.append(card)}el.album.hidden=false;document.getElementById('albumClose').focus()}
