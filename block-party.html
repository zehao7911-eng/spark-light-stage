<title>BLOCK PARTY — Stack & Bank</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root{color-scheme:dark;--ink:#f5f6fa;--muted:#abb7c8;--line:#ffffff1c;--glass:#141e2ac9;--mint:#92f3c4;--gold:#ffcf68;--pink:#ff829c;--sky:#111927}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--sky);font-family:'Space Grotesk',system-ui,sans-serif;color:var(--ink);touch-action:manipulation}button{font:inherit;color:inherit;cursor:pointer}#game{position:fixed;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 23%,#263c59 0%,#172638 48%,#101724 100%)}canvas{position:absolute;inset:0;width:100%;height:100%;display:block}.shade{position:absolute;inset:0;background:linear-gradient(180deg,#0d14274a,transparent 19%,transparent 65%,#0a1118bb);pointer-events:none}.top{position:absolute;left:0;right:0;top:0;padding:calc(15px + env(safe-area-inset-top)) clamp(15px,4vw,48px) 0;display:flex;justify-content:space-between;align-items:flex-start;pointer-events:none}.brand{pointer-events:auto}.eyebrow{font:500 10px 'DM Mono',monospace;letter-spacing:.2em;color:var(--mint);text-transform:uppercase}.brand h1{font-size:clamp(20px,3.2vw,30px);line-height:1;margin:5px 0 0;letter-spacing:-.07em;font-weight:700}.wallet{pointer-events:auto;display:flex;align-items:center;gap:9px;padding:9px 13px;border:1px solid #ffffff1d;border-radius:999px;background:#101927ad;backdrop-filter:blur(10px);font:500 12px 'DM Mono',monospace;box-shadow:0 4px 20px #0002}.gem{display:inline-grid;place-items:center;color:#8df7c1;font-size:16px;text-shadow:0 0 12px #4be59b}.wallet .sound{width:28px;height:28px;border:0;border-radius:50%;background:#ffffff0e;color:#dce6ed;margin:-4px -4px -4px 2px;font-size:14px}.readout{position:absolute;top:calc(88px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:center;padding:7px 11px;border-radius:9px;background:#111b28ad;border:1px solid #ffffff16;backdrop-filter:blur(8px);white-space:nowrap;font:500 11px 'DM Mono',monospace;letter-spacing:.04em}.readout strong{color:var(--gold);font-size:13px}.readout .sep{color:#738194}.status{position:absolute;left:50%;top:calc(124px + env(safe-area-inset-top));transform:translateX(-50%);color:#c0cbda;font:500 10px 'DM Mono',monospace;letter-spacing:.17em;text-transform:uppercase;white-space:nowrap;text-shadow:0 1px 5px #000}.controls{position:absolute;left:0;right:0;bottom:0;padding:0 clamp(14px,4vw,42px) calc(13px + env(safe-area-inset-bottom));display:flex;align-items:flex-end;justify-content:space-between;gap:12px;pointer-events:none}.controls>*{pointer-events:auto}.left-tools{display:flex;align-items:flex-end;gap:9px}.stakebox{padding:9px;background:#111a27c9;border:1px solid #ffffff18;border-radius:15px;backdrop-filter:blur(12px)}.stake-caption{font:500 9px 'DM Mono',monospace;letter-spacing:.16em;color:#9babc0;margin:0 0 7px 2px}.chips{display:flex;gap:5px}.chip{border:1px solid transparent;border-radius:9px;background:#ffffff0b;color:#bac5d1;padding:8px 10px;min-width:42px;font:500 11px 'DM Mono',monospace}.chip.selected{background:#8ff0c522;border-color:#83edbc99;color:#b6ffda;box-shadow:inset 0 0 14px #71efb318}.actions{display:flex;align-items:flex-end;gap:8px}.bank,.drop{height:48px;border-radius:13px;border:1px solid #ffffff1d;backdrop-filter:blur(12px);font-weight:700;letter-spacing:.025em;box-shadow:0 7px 20px #0003;transition:transform .12s,filter .12s}.bank:active,.drop:active{transform:translateY(2px) scale(.98)}.bank{padding:0 14px;background:#162535d9;color:#d4e6e5;min-width:93px;font-size:12px}.bank:disabled{opacity:.44;cursor:default}.drop{padding:0 21px;min-width:137px;background:linear-gradient(135deg,#b7ffcf,#6fe8b1 65%,#5dd4ba);border-color:#ceffe1;color:#10231e;font-size:13px;box-shadow:0 5px 24px #63e9b254,inset 0 1px #fff9}.drop small{font:500 9px 'DM Mono',monospace;opacity:.7;display:block;margin-top:1px}.prompt{position:absolute;left:50%;bottom:calc(88px + env(safe-area-inset-bottom));transform:translateX(-50%);border:0;background:transparent;color:#eef6f0;font:500 11px 'DM Mono',monospace;letter-spacing:.17em;text-shadow:0 2px 12px #000;white-space:nowrap;pointer-events:none}.toast{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%) scale(.75);opacity:0;pointer-events:none;font-weight:700;letter-spacing:.02em;color:var(--gold);font-size:clamp(20px,5vw,40px);text-shadow:0 2px 0 #704d19,0 0 24px #ffd36faa;white-space:nowrap;transition:opacity .12s,transform .18s cubic-bezier(.2,.9,.3,1.4)}.toast.show{opacity:1;transform:translate(-50%,-50%) scale(1)}.toast.mint{color:var(--mint);text-shadow:0 2px 0 #164d42,0 0 28px #88ffd6}.modal{position:absolute;inset:0;display:grid;place-items:center;padding:24px;background:#080e19a6;backdrop-filter:blur(7px);opacity:0;pointer-events:none;transition:opacity .2s}.modal.show{opacity:1;pointer-events:auto}.card{width:min(330px,calc(100vw - 36px));text-align:center;padding:26px 22px 20px;border:1px solid #ffffff27;border-radius:22px;background:linear-gradient(145deg,#1d2b39f5,#101a28f5);box-shadow:0 22px 90px #0008,0 0 42px #86edc016;transform:translateY(9px) scale(.98);transition:transform .24s}.modal.show .card{transform:none}.card .medal{font-size:34px;filter:drop-shadow(0 0 15px #ffcc5577)}.card h2{font-size:24px;letter-spacing:-.05em;margin:7px 0 5px}.card p{font:11px 'DM Mono',monospace;color:#aebccd;margin:0 0 18px}.final-score{font:500 10px 'DM Mono',monospace;letter-spacing:.14em;color:#a7b4c4;text-transform:uppercase}.final-score strong{display:block;font:700 36px 'Space Grotesk',sans-serif;letter-spacing:-.06em;color:var(--gold);margin:3px 0 17px}.again{width:100%;height:47px;border:0;border-radius:12px;background:linear-gradient(135deg,#b7ffcf,#69e7b1 65%,#58d3b3);color:#0f2820;font-weight:700}.tiny{font:9px 'DM Mono',monospace;color:#8594a8;margin-top:12px;letter-spacing:.12em;text-transform:uppercase}.burst{position:absolute;inset:0;pointer-events:none;background:#baffd5;opacity:0}.burst.on{animation:flash .26s ease-out}@keyframes flash{0%{opacity:.17}100%{opacity:0}}.newbest{color:var(--gold)!important}
@media(max-width:600px){.top{padding-left:15px;padding-right:15px}.brand h1{font-size:23px}.eyebrow{font-size:9px}.wallet{padding:7px 10px;gap:7px;font-size:11px}.wallet .sound{width:26px;height:26px}.readout{top:calc(79px + env(safe-area-inset-top));font-size:10px;padding:6px 9px}.status{top:calc(111px + env(safe-area-inset-top));font-size:9px}.controls{display:grid;grid-template-columns:1fr;gap:8px;padding-left:13px;padding-right:13px;padding-bottom:calc(12px + env(safe-area-inset-bottom))}.left-tools{justify-content:center}.stakebox{padding:7px 8px 8px;border-radius:12px}.stake-caption{margin-bottom:5px;font-size:8px}.chip{padding:7px 10px;min-width:50px}.actions{display:grid;grid-template-columns:.78fr 1.35fr;gap:8px}.bank,.drop{height:48px}.bank{min-width:0}.drop{min-width:0}.prompt{bottom:calc(140px + env(safe-area-inset-bottom));font-size:10px}.toast{top:45%}}
@media(max-height:650px) and (max-width:800px){.controls{padding-bottom:calc(7px + env(safe-area-inset-bottom));gap:5px}.stakebox{padding:5px 7px}.stake-caption{display:none}.bank,.drop{height:42px}.prompt{bottom:calc(116px + env(safe-area-inset-bottom))}.readout{top:calc(67px + env(safe-area-inset-top))}.status{top:calc(98px + env(safe-area-inset-top))}.brand h1{font-size:20px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;animation-duration:.01ms!important;animation-iteration-count:1!important}}
