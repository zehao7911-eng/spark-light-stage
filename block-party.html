<body>
<main id="game" aria-label="Block Party game">
  <canvas id="world" aria-label="A voxel block tower in the sky"></canvas><div class="shade"></div><div class="burst" id="burst"></div>
  <header class="top"><div class="brand"><div class="eyebrow">STACK · BANK · BRAG</div><h1>BLOCK PARTY<span style="color:var(--mint)">.</span></h1></div><div class="wallet"><span class="gem">◆</span><span id="wallet">500</span><span style="color:#8090a2;font-size:9px;letter-spacing:.1em">BITS</span><button class="sound" id="sound" aria-label="Toggle sound">♫</button></div></header>
  <div class="readout"><span>STREAK <strong id="streak">0</strong></span><span class="sep">/</span><span>BOOST <strong id="mult">1.00×</strong></span><span class="sep">/</span><span>BEST <strong id="best">0</strong></span></div>
  <div class="status" id="status">PICK A STAKE · THEN DROP</div>
  <div class="prompt" id="prompt">TAP TO DROP</div>
  <div class="toast" id="toast">NICE!</div>
  <footer class="controls"><div class="left-tools"><div class="stakebox"><div class="stake-caption">YOUR STAKE · BITS</div><div class="chips" id="chips"><button class="chip" data-stake="10">10</button><button class="chip selected" data-stake="25">25</button><button class="chip" data-stake="50">50</button><button class="chip" data-stake="100">100</button></div></div></div><div class="actions"><button class="bank" id="bank" disabled>BANK <span id="bankValue">—</span></button><button class="drop" id="drop">START RUN<small>CHOOSE A STAKE</small></button></div></footer>
  <section class="modal" id="modal" aria-hidden="true"><div class="card"><div class="medal" id="medal">💥</div><h2 id="modalTitle">Tower toppled!</h2><p id="modalCopy">One more block? Too ambitious.</p><div class="final-score">YOU WALKED AWAY WITH<strong id="finalValue">0 BITS</strong></div><button class="again" id="again">BUILD AGAIN</button><div class="tiny" id="recordTag">BEST STACK · 0</div></div></section>
</main>
<script>
(()=>{
'use strict';
const $=s=>document.querySelector(s), canvas=$('#world'),ctx=canvas.getContext('2d',{alpha:false});
const ui={wallet:$('#wallet'),streak:$('#streak'),mult:$('#mult'),best:$('#best'),status:$('#status'),prompt:$('#prompt'),bank:$('#bank'),bankValue:$('#bankValue'),drop:$('#drop'),chips:$('#chips'),modal:$('#modal'),title:$('#modalTitle'),copy:$('#modalCopy'),final:$('#finalValue'),medal:$('#medal'),record:$('#recordTag'),toast:$('#toast'),burst:$('#burst'),sound:$('#sound')};
const COLORS=['#62dcb7','#ffbe62','#ba91ff','#ff7b91','#67c5fa','#e1dd79'];
let W=0,H=0,DPR=1,blocks=[],floaters=[],particles=[],confetti=[],time=0,last=0,selected=25,wallet=Number(localStorage.getItem('blockPartyWallet'))||500,best=Number(localStorage.getItem('blockPartyBest'))||0,live=false,animating=false,ended=false,stake=25,multiplier=1,streak=0,banked=0,soundOn=false,audio=null,move={offset:-90,dir:1,speed:150},settle=0,shake=0,lastToast=0;
const HGT=24,DEPTH=.39;
function resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=innerWidth;H=innerHeight;canvas.width=Math.floor(W*DPR);canvas.height=Math.floor(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0)}
window.addEventListener('resize',resize,{passive:true});resize();
function palette(level){return COLORS[Math.floor(level/3)%COLORS.length]}
function walletText(){ui.wallet.textContent=Math.floor(wallet).toLocaleString('en-US');ui.best.textContent=best;ui.streak.textContent=streak;ui.mult.textContent=multiplier.toFixed(2)+'×';ui.bankValue.textContent=live?Math.floor(stake*multiplier).toLocaleString('en-US'):'—';ui.bank.disabled=!live||animating||blocks.length<=2;ui.drop.disabled=animating||ended;ui.drop.style.filter=animating?'brightness(.76)':'';localStorage.setItem('blockPartyWallet',wallet);localStorage.setItem('blockPartyBest',best)}
function sound(freq=500,duration=.09,type='sine',gain=.045){if(!soundOn)return;try{audio??=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(freq,audio.currentTime);o.frequency.exponentialRampToValueAtTime(Math.max(80,freq*.67),audio.currentTime+duration);g.gain.setValueAtTime(gain,audio.currentTime);g.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);o.connect(g).connect(audio.destination);o.start();o.stop(audio.currentTime+duration)}catch{}}
function rand(a,b){return a+Math.random()*(b-a)}
function rect(x,y,w,h,c){ctx.fillStyle=c;ctx.fillRect(Math.round(x),Math.round(y),Math.ceil(w),Math.ceil(h))}
function polygon(pts,c){ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(pts[0][0],pts[0][1]);for(let i=1;i<pts.length;i++)ctx.lineTo(pts[i][0],pts[i][1]);ctx.closePath();ctx.fill()}
function rounded(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function block(cx,cy,w,h,depth,color,glow=false,pattern=0){let d=Math.max(8,w*depth);let x=cx-w/2,y=cy-d/2;const rgb=hex=>{let n=parseInt(hex.slice(1),16);return[(n>>16)&255,(n>>8)&255,n&255]};let[cr,cg,cb]=rgb(color);const shade=(a,b,c)=>`rgb(${Math.min(255,Math.max(0,cr*a+b))},${Math.min(255,Math.max(0,cg*a+b))},${Math.min(255,Math.max(0,cb*a+c))})`;let top=shade(1,13,20),left=shade(.69,-9,-12),right=shade(.49,-12,-15);if(glow){ctx.shadowColor=color;ctx.shadowBlur=17}
 polygon([[x,y],[x+w/2,y-d/2],[x+w,y],[x+w/2,y+d/2]],top);
 polygon([[x,y],[x+w/2,y+d/2],[x+w/2,y+d/2+h],[x,y+h]],left);
 polygon([[x+w,y],[x+w/2,y+d/2],[x+w/2,y+d/2+h],[x+w,y+h]],right);
 ctx.shadowBlur=0;
 // pixel flecks on top face
 if(w>40&&pattern){ctx.save();ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+w/2,y-d/2);ctx.lineTo(x+w,y);ctx.lineTo(x+w/2,y+d/2);ctx.closePath();ctx.clip();for(let i=0;i<pattern;i++){let px=x+8+((i*37+pattern*19)%(Math.max(1,w-16))),py=y-d*.42+((i*13+pattern*5)%(Math.max(1,Math.floor(d*.8))));rect(px,py,3+(i%3),2+(i%2),shade(1,40,32))}ctx.restore()}
 ctx.strokeStyle='#ffffff12';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(x+.5,y+.5);ctx.lineTo(x+w/2,y+d/2);ctx.lineTo(x+w-.5,y+.5);ctx.stroke();
 // checker seams on visible side faces
 if(w>52){ctx.globalAlpha=.13;rect(x+5,y+h*.53,Math.max(2,w*.12),2,'#fff');rect(x+w/2+5,y+d/2+h*.52,Math.max(2,w*.1),2,'#fff');ctx.globalAlpha=1}
}
function cloud(x,y,s,alpha){ctx.save();ctx.globalAlpha=alpha;rect(x,y,s*2.25,s*.53,'#bfd7df');rect(x+s*.3,y-s*.42,s*1.15,s*.55,'#d8e7e5');rect(x+s*1.1,y-s*.24,s*.9,s*.45,'#cfdfdf');rect(x+s*.15,y+s*.52,s*1.9,s*.12,'#8daeb8');ctx.restore()}
function drawCreeper(x,y,s){ctx.save();ctx.translate(Math.round(x),Math.round(y));let a=s;rect(-a*.45,-a*1.55,a*.9,a*.85,'#66c875');rect(-a*.57,-a*.65,a*1.14,a*1.15,'#54b969');rect(-a*.52,a*.48,a*.33,a*.48,'#348b56');rect(a*.19,a*.48,a*.33,a*.48,'#348b56');rect(-a*.28,-a*1.25,a*.17,a*.19,'#17382f');rect(a*.11,-a*1.25,a*.17,a*.19,'#17382f');rect(-a*.12,-a*1.04,a*.24,a*.31,'#18382e');rect(-a*.28,-a*.91,a*.14,a*.22,'#18382e');rect(a*.14,-a*.91,a*.14,a*.22,'#18382e');rect(-a*.45,-a*1.55,a*.13,a*.13,'#b0f18a');ctx.restore()}
function drawBackground(dt){let sky=ctx.createLinearGradient(0,0,0,H);sky.addColorStop(0,'#172537');sky.addColorStop(.58,'#203e4c');sky.addColorStop(1,'#827051');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);
 // distant aurora arcs
 let glow=ctx.createRadialGradient(W*.52,H*.38,5,W*.52,H*.38,Math.min(W,H)*.59);glow.addColorStop(0,'#6ce8c412');glow.addColorStop(.55,'#66bfd009');glow.addColorStop(1,'#08111a00');ctx.fillStyle=glow;ctx.fillRect(0,0,W,H);
 time+=dt;
 for(let i=0;i<3;i++){let x=((i*W*.51+time*(9+i*5))%(W+250))-120,y=H*(.19+i*.14)+Math.sin(time*.18+i*2)*9;cloud(x,y,18+i*4,.18+i*.045)}
 // tiny pixel stars / fireflies
 for(let i=0;i<31;i++){let x=(i*167.3+Math.sin(i*91)*22)%W,y=(i*91.7)%(H*.65);let a=.25+.55*(.5+.5*Math.sin(time*1.5+i));rect(x,y,1.6,1.6,`rgba(211,255,220,${a})`)}
 // floating voxel islets
 for(let i=0;i<5;i++){let x=(i*W*.29+time*(i%2?4:-3))%(W+220)-80,y=H*(.35+i*.065)+Math.sin(time*.34+i)*10;let size=22+(i*17)%35;block(x,y,size,12,0.31,['#5a857d','#657f75','#667a69'][i%3],false,0);block(x,y+8,size*.79,12,0.3,['#3b594c','#534e43','#455744'][i%3],false,0)}
 // far hills and pixel ledges
 polygon([[0,H*.74],[W*.12,H*.63],[W*.27,H*.74],[W*.43,H*.62],[W*.58,H*.72],[W*.77,H*.61],[W,H*.71],[W,H],[0,H]],'#263e3d');
 polygon([[0,H*.84],[W*.21,H*.72],[W*.4,H*.82],[W*.62,H*.7],[W*.82,H*.79],[W,H*.71],[W,H],[0,H]],'#182b2d');
 // small voxel trees on silhouettes
 for(let i=0;i<7;i++){let x=i*W/6+14,y=H*(.72+(i%2)*.065),s=11+(i%3)*3;rect(x-3,y-s*2,s*.8,s*2,'#2e644b');rect(x-s*.63,y-s*2.3,s*2,s*.85,'#347658');rect(x-s*.36,y-s*2.72,s*1.3,s*.66,'#478d65')}
 // front floating ledge
 let ledgeY=Math.min(H*.78,H-150);polygon([[0,ledgeY],[W*.14,ledgeY-13],[W*.44,ledgeY-2],[W*.69,ledgeY-18],[W,ledgeY-5],[W,H],[0,H]],'#182629');polygon([[0,ledgeY],[W*.14,ledgeY-13],[W*.44,ledgeY-2],[W*.69,ledgeY-18],[W,ledgeY-5],[W,ledgeY+13],[W*.69,ledgeY+1],[W*.44,ledgeY+16],[W*.14,ledgeY+3],[0,ledgeY+14]],'#42644e');
 // decor crystals
 for(let i=0;i<8;i++){let x=(i*W/7+11)%W,y=ledgeY+(i%2?15:5),c=i%2?'#6bdabb':'#f2cf68';ctx.save();ctx.shadowColor=c;ctx.shadowBlur=8;polygon([[x,y-6],[x+4,y],[x,y+7],[x-4,y]],c);ctx.restore()}
 drawCreeper(W*.82,ledgeY-3,11);
}
function screen(){let cx=W/2,baseY=Math.min(H*.735,H-173);if(innerWidth<601)baseY=Math.min(H*.69,H-207);let floorW=Math.min(180,W*.43);block(cx,baseY,floorW,24,0.38,'#777a60',true,3);block(cx,baseY+21,floorW*.94,18,0.35,'#525a48',false,2);
 let camera=Math.max(0,blocks.length-8);let start=Math.max(0,blocks.length-20);for(let i=start;i<blocks.length;i++){let level=i+1,visibleY=baseY-level*HGT+camera*HGT*.72;block(cx+(blocks[i].x||0)-camera*1.1,visibleY,blocks[i].w,HGT,DEPTH,blocks[i].color,false,blocks[i].pattern||2)}
 if(!ended){let level=blocks.length+(live?1:0);let topY=baseY-level*HGT+camera*HGT*.72;let movingWidth=blocks.at(-1)?.w||floorW;let range=Math.min(W*.32,Math.max(86,movingWidth*1.12));let x=cx+(live?move.offset:Math.sin(time*1.15)*range*.76);ctx.save();ctx.globalAlpha=live?.18:.11;ctx.strokeStyle='#d9ffe8';ctx.setLineDash([3,5]);ctx.beginPath();ctx.moveTo(cx-range,topY+18);ctx.lineTo(cx+range,topY+18);ctx.stroke();ctx.restore();block(x,topY,movingWidth,HGT,DEPTH,live?palette(blocks.length):'#70ddaf',true,3);let bob=Math.sin(time*6)*2;drawCreeper(cx+range+25,topY+6+bob,12)}
 // sparkle motes
 for(let i=particles.length-1;i>=0;i--){let p=particles[i];p.x+=p.vx*.016;p.y+=p.vy*.016;p.vy+=.28;p.life-=.016;if(p.life<=0){particles.splice(i,1);continue}ctx.globalAlpha=Math.min(1,p.life/p.max);ctx.save();ctx.shadowColor=p.c;ctx.shadowBlur=11;rect(p.x,p.y,p.s,p.s,p.c);ctx.restore();ctx.globalAlpha=1}
 for(let i=floaters.length-1;i>=0;i--){let p=floaters[i];p.x+=p.vx*.016;p.y+=p.vy*.016;p.vy+=.26;p.rot+=p.vr*.016;p.life-=.016;if(p.life<=0){floaters.splice(i,1);continue}ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);block(0,0,p.s,p.s*.55,p.s*.25,p.c,false,0);ctx.restore()}
 for(let i=confetti.length-1;i>=0;i--){let p=confetti[i];p.x+=p.vx*.016;p.y+=p.vy*.016;p.vy+=.19;p.rot+=p.vr*.016;p.life-=.016;if(p.life<=0){confetti.splice(i,1);continue}ctx.save();ctx.globalAlpha=Math.min(1,p.life);ctx.translate(p.x,p.y);ctx.rotate(p.rot);rect(-p.s/2,-p.s/2,p.s,p.s*.65,p.c);ctx.restore()}
 }
function frame(ts){let dt=Math.min(.035,(ts-last)/1000||0);last=ts;if(!animating){if(live){let max=Math.min(W*.32,Math.max(86,(blocks.at(-1)?.w||Math.min(180,W*.43))*1.12));move.offset+=move.dir*move.speed*dt;if(move.offset>=max){move.offset=max;move.dir=-1}else if(move.offset<=-max){move.offset=-max;move.dir=1}}}else if(settle>0){settle-=dt;if(settle<=0){animating=false;walletText()}}if(shake){shake*=.84;if(shake<.3)shake=0}ctx.save();if(shake)ctx.translate(rand(-shake,shake),rand(-shake*.6,shake*.6));drawBackground(dt);screen();ctx.restore();requestAnimationFrame(frame)}
requestAnimationFrame(frame);
function toast(text,mint=false){ui.toast.textContent=text;ui.toast.classList.toggle('mint',mint);ui.toast.classList.add('show');clearTimeout(lastToast);lastToast=setTimeout(()=>ui.toast.classList.remove('show'),730)}
function burst(){ui.burst.classList.remove('on');void ui.burst.offsetWidth;ui.burst.classList.add('on')}
function popConfetti(count=65){for(let i=0;i<count;i++)confetti.push({x:W/2+rand(-W*.22,W*.22),y:H*.42+rand(-26,26),vx:rand(-175,175),vy:rand(-230,-40),s:rand(4,9),rot:0,vr:rand(-8,8),life:rand(1.2,2),c:['#8cffc5','#ffd267','#fa879c','#d2a2ff','#82d9ff'][i%5]})}
function sparks(x,y,n=24,color='#caffdd'){for(let i=0;i<n;i++)particles.push({x,y,vx:rand(-165,165),vy:rand(-190,45),s:rand(2,5),life:rand(.4,.95),max:.95,c:i%3?color:'#fff'})}
function start(){if(live||animating||ended)return;if(wallet<10){wallet+=250;walletText();toast('FREE BITS!');sound(480,.16,'sine');return}if(wallet<selected){toast('LOWER YOUR STAKE');sound(180,.16,'triangle');return}stake=selected;wallet-=stake;multiplier=1;streak=0;blocks=[{w:Math.min(180,W*.43),x:0,color:'#7a8260',pattern:3},{w:Math.min(180,W*.43)*.94,x:0,color:'#656d54',pattern:2}];live=true;move={offset:-Math.min(W*.32,128),dir:1,speed:145};ui.status.textContent='STACK CLEAN · BANK WHENEVER';ui.prompt.textContent='TAP TO DROP';ui.drop.innerHTML='DROP BLOCK<small>SPACE · TAP</small>';walletText();sound(380,.11,'triangle');}
function drop(){if(animating||ended)return;if(!live){start();return}let current=blocks.at(-1),width=current.w,offset=move.offset;let overlap=width-Math.abs(offset);let floorW=Math.min(180,W*.43);if(overlap<=Math.max(9,width*.13)){miss();return}
 // settle to the overlap; the screen camera follows the growing stack
 let quality=Math.min(1,overlap/width);let newW=overlap;let dir=Math.sign(offset)||move.dir;let newX=(current.x||0)+offset/2;
 if(width-newW>1.5){let chipW=width-newW,x=W/2+(current.x||0)+dir*(width/2-newW/2);floaters.push({x,y:Math.min(H*.7,H-195)-blocks.length*HGT,w:chipW,s:Math.max(11,chipW),vx:dir*rand(40,105),vy:rand(8,72),rot:0,vr:dir*rand(2,6),life:1.2,c:'#698b70'});sparks(x,Math.min(H*.7,H-195)-blocks.length*HGT,7,'#aaffd3')}
 blocks.push({w:newW,x:newX,color:palette(blocks.length),pattern:3});let perfect=quality>.91;streak=perfect?streak+1:0;
 // very clean taps stretch the multiplier; every fifth block reveals a bright diamond bonus
 let stepFactor=1.16+Math.min(.28,quality*.25)+(perfect?.13:0);multiplier=Math.min(1e12,multiplier*stepFactor);
 if(blocks.length%5===0){multiplier*=1.55;toast('DIAMOND STREAK!',true);sparks(W/2,H*.39,38,'#baf9ff');popConfetti(24);burst();sound(860,.2,'sine',.07)}else if(perfect){toast(streak>=3?'CLEAN STREAK!':'PERFECT!',true);sound(690+Math.min(streak,8)*35,.085,'sine')}else{toast('NICE!',false);sound(440,.09,'triangle')}
 if(quality>.91){sparks(W/2,H*.46,15,'#f4ffbe')}
 move.offset=rand(-88,88);move.dir=Math.random()<.5?-1:1;move.speed=Math.min(310,145+blocks.length*7.5);move.offset*=Math.min(1,newW/(floorW*.52));
 banked=Math.floor(stake*multiplier);settle=.16;animating=true;walletText();
 if(blocks.length>best){best=blocks.length-2;ui.best.textContent=best}
}
function miss(){live=false;ended=true;animating=false;streak=0;shake=13;sound(125,.34,'sawtooth',.08);toast('CRUNCH!');sparks(W/2,H*.64,32,'#ff9d79');setTimeout(()=>finish(false),420);ui.prompt.textContent='';ui.status.textContent='THE TOWER HAD OTHER PLANS';walletText()}
function finish(won){ui.title.textContent=won?'Banked. Brilliant.':'Tower toppled!';ui.copy.textContent=won?'Nice timing. The diamonds are yours.':'Your unbanked bits became cave dust.';ui.medal.textContent=won?'💎':'🧱';ui.final.textContent=won?Math.floor(stake*multiplier).toLocaleString('en-US')+' BITS':'0 BITS';let record=blocks.length-2;ui.record.textContent='BEST STACK · '+best;ui.record.classList.toggle('newbest',record>=best&&record>2);ui.modal.classList.add('show');ui.modal.setAttribute('aria-hidden','false');walletText()}
function bank(){if(!live||animating)return;live=false;ended=true;let payout=Math.floor(stake*multiplier);wallet+=payout;banked=payout;ui.status.textContent='BANKED · NICE ONE';ui.prompt.textContent='';sound(740,.12,'triangle');setTimeout(()=>sound(990,.18,'sine'),90);popConfetti(52);sparks(W/2,H*.41,35,'#c4ffde');burst();walletText();setTimeout(()=>finish(true),290)}
function reset(){ui.modal.classList.remove('show');ui.modal.setAttribute('aria-hidden','true');ui.status.textContent='PICK A STAKE · THEN DROP';ui.prompt.textContent='TAP TO DROP';ui.drop.innerHTML='START RUN<small>CHOOSE A STAKE</small>';ended=false;live=false;animating=false;streak=0;multiplier=1;blocks=[{w:Math.min(180,W*.43),x:0,color:'#777a60',pattern:3},{w:Math.min(180,W*.43)*.94,x:0,color:'#525a48',pattern:2}];walletText()}
ui.drop.addEventListener('click',drop);ui.bank.addEventListener('click',bank);$('#again').addEventListener('click',reset);ui.chips.addEventListener('click',e=>{let b=e.target.closest('[data-stake]');if(!b||live||animating)return;selected=+b.dataset.stake;ui.chips.querySelectorAll('.chip').forEach(x=>x.classList.toggle('selected',x===b));sound(330,.04,'sine');});ui.sound.addEventListener('click',()=>{soundOn=!soundOn;ui.sound.textContent=soundOn?'♫':'♪';ui.sound.style.color=soundOn?'#9bffd0':'#dce6ed';if(soundOn)sound(560,.08)});canvas.addEventListener('pointerdown',e=>{if(e.target===canvas){if(live)drop();else if(!ended)start()}});window.addEventListener('keydown',e=>{if(e.code==='Space'&&!e.repeat){e.preventDefault();drop()}if(e.key==='Escape'&&live)bank()});
// Start with a handsome idle tower rather than a blank instruction screen.
blocks=[{w:Math.min(180,W*.43),x:0,color:'#777a60',pattern:3},{w:Math.min(180,W*.43)*.94,x:0,color:'#525a48',pattern:2}];ui.best.textContent=best;walletText();
})();
</script>
