function showKitchenEvent(){if(stateOver())return;openModal(`<div class="modal-emoji">👩‍🍳</div><div class="overline">EVERY FIFTH ROUND · A KITCHEN CHARM</div><h2 id="modalTitle">Pick a pinch of magic</h2><p>Munchy found something in the pantry. Choose one odd little upgrade for the next stretch.</p><div class="event-picks" id="eventPicks"></div>`);const options=[];while(options.length<3){const u=upgrades[(rand()*upgrades.length)|0];if(!options.includes(u)&&!(u.name==='Soft Landing'&&hearts===3))options.push(u)}$('#eventPicks').innerHTML=options.map((u,i)=>`<button class="event-pick" data-up="${i}"><b>${u.icon} ${u.name}</b><small>${u.text}</small></button>`).join('');$$('.event-pick').forEach((b,i)=>b.addEventListener('click',()=>{const u=options[i];if(u.name==='Soft Landing')hearts=Math.min(3,hearts+1);else{upgradesOwned.push(u);if(u.name==='Bottomless Spoon')bank+=35}closeModal();say(`${u.name.toUpperCase()} ADDED`);figure.className='figure happy';throwBits(44);makeRound()}))}
