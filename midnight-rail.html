<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no"><meta name="theme-color" content="#090e1c">
<title>LAST LIGHT EXPRESS</title><link rel="icon" href="data:,">
<style>
:root{--ink:#0a101e;--cream:#f5e7cf;--muted:#a4bbbf;--gold:#f8c979;--pink:#f58b9b;--cyan:#88e3e3}
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#080e1a;color:var(--cream);font-family:Consolas,'Courier New',monospace;touch-action:none;user-select:none}button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}canvas{image-rendering:pixelated}#world{position:fixed;inset:0;width:100%;height:100%;display:block;object-fit:cover}#grain{position:fixed;inset:0;pointer-events:none;opacity:.13;background-image:repeating-linear-gradient(0deg,#fff1 0,#fff1 1px,transparent 1px,transparent 4px);mix-blend-mode:soft-light}#vignette{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 46%,transparent 42%,#030712a8 100%)}
#hud{position:fixed;z-index:3;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:flex-start;gap:15px;padding:calc(env(safe-area-inset-top) + 20px) 24px 0;text-shadow:0 2px 7px #03050c}.logo{color:#ffdf99;font-size:15px;font-weight:900;letter-spacing:.13em;line-height:1.1}.logo small{display:block;margin-top:5px;color:#adced0;font-size:8px;font-weight:400;letter-spacing:.18em}.hud-right{display:flex;gap:6px}.pill{padding:7px 10px;border:1px solid #a2cbca86;background:#0b2331be;box-shadow:inset 0 1px #ffffff2a,0 5px 18px #02070c88;font-size:10px;white-space:nowrap}.pill b{color:var(--gold)}#phase{color:var(--cyan)}
#mission{position:fixed;z-index:3;top:calc(env(safe-area-inset-top) + 73px);left:50%;transform:translateX(-50%);padding:8px 15px;border:1px solid #d3e4d051;background:#0a1925bb;backdrop-filter:blur(4px);font-size:10px;letter-spacing:.07em;text-align:center;white-space:nowrap;max-width:94vw;overflow:hidden;text-overflow:ellipsis;text-shadow:0 2px 5px #000}#toast{position:fixed;z-index:8;top:25%;left:50%;transform:translate(-50%,10px) scale(.9);opacity:0;pointer-events:none;font-weight:900;letter-spacing:.1em;color:#fff1b9;font-size:clamp(20px,4vw,36px);text-shadow:0 0 25px #ffb765,2px 3px #251922;transition:transform .18s,opacity .18s;white-space:nowrap}#toast.show{opacity:1;transform:translate(-50%,0) scale(1)}#screenFlash{position:fixed;inset:0;z-index:7;pointer-events:none;background:#ffcf8b;opacity:0;transition:opacity .3s}
#bottom{position:fixed;z-index:3;left:0;right:0;bottom:0;padding:0 24px calc(env(safe-area-inset-bottom) + 20px);display:flex;justify-content:space-between;align-items:end;gap:15px;pointer-events:none}.meterbox{width:min(270px,34vw);text-shadow:0 2px 4px #000}.meter-label{display:flex;justify-content:space-between;font-size:10px;font-weight:900;letter-spacing:.12em}.meter{height:17px;margin-top:6px;border:2px solid #e7ddb8;background:#142333;box-shadow:0 4px 15px #020511a8;transform:skewX(-10deg)}.meter i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#e26880,#f5ba83,#f9d88a);transition:width .18s}.bagline{margin-top:8px;color:#dbe6d2;font-size:10px}.bagline b{color:#ffdc8a}.actions{pointer-events:auto;display:flex;gap:7px}.gamebtn{height:46px;min-width:50px;padding:6px 12px;color:#f8ead4;border:2px solid #b6d8d5;background:linear-gradient(#294c55,#112c38);box-shadow:inset 0 2px #ffffff32,0 4px 16px #020616b0;font-size:10px;font-weight:900;letter-spacing:.05em}.gamebtn:active{transform:translateY(3px);filter:brightness(1.4)}.gamebtn.gold{border-color:#ffd894;background:linear-gradient(#a97554,#704651)}.gamebtn span{display:block;font-size:16px;line-height:19px}
#touch{display:none;position:fixed;z-index:4;left:0;right:0;bottom:calc(env(safe-area-inset-bottom) + 20px);height:91px;pointer-events:none}.touch-left,.touch-right{position:absolute;bottom:0;display:flex;gap:10px;pointer-events:auto}.touch-left{left:20px}.touch-right{right:20px}.touchkey{width:65px;height:65px;border-radius:50%;border:2px solid #bdd7d0;background:#17333dc4;color:#f6ecda;font-size:22px;box-shadow:0 4px 18px #020713,inset 0 2px #fff3}.touchkey.action{width:75px;height:75px;background:#bd745d;border-color:#ffe0a2;font-size:26px}.touchkey:active{transform:scale(.91);filter:brightness(1.2)}
.overlay{position:fixed;z-index:10;inset:0;display:flex;justify-content:center;align-items:center;padding:18px;background:#06101db5;backdrop-filter:blur(7px)}.overlay.hidden{display:none}.panel{width:min(490px,100%);max-height:min(88vh,760px);overflow:auto;border:2px solid #deb985;outline:5px solid #0d2028;background:linear-gradient(160deg,#1f3b45f5,#0d222ef7 72%);box-shadow:0 25px 100px #000b,inset 0 0 0 3px #e7f1dc17;padding:29px 28px 26px;text-align:center}.eyebrow{font-size:10px;color:#a8dddd;letter-spacing:.31em}.panel h1{font-family:Georgia,serif;font-size:clamp(42px,8vw,76px);line-height:1.02;letter-spacing:-.045em;margin:15px 0 20px;text-shadow:4px 5px #091826}.panel h1 em{font-style:normal;color:#ffd494}.panel p{color:#c6dbd7;font-size:12px;line-height:1.6}.panel .primary{display:block;width:100%;border:2px solid #fff0c7;background:linear-gradient(#f6ce8b,#da996d);padding:14px;margin-top:20px;color:#20343d;font-size:12px;font-weight:900;letter-spacing:.14em;box-shadow:0 5px #694f46}.panel .primary:active{transform:translateY(4px);box-shadow:0 1px #694f46}.hint{margin-top:16px;color:#96b3b8;font-size:9px;line-height:1.6}.divider{height:1px;background:#aacfc15c;margin:18px 0}.loot-summary{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;color:#ffe1a9;font-size:12px}.upgrades{display:grid;gap:8px;margin-top:14px}.upgrade{text-align:left;padding:10px 13px;border:1px solid #b6d7caa5;background:#1a3d47;color:#f7ead2;display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:9px}.upgrade:disabled{opacity:.43;filter:grayscale(.5)}.upgrade strong{font-size:11px}.upgrade small{display:block;margin-top:3px;color:#b3d0ce;font-size:9px}.upgrade .symbol{font-size:25px;color:#ffe1a3}.upgrade .cost{color:#f8ca83;font-size:10px}.level-line{margin:8px 0 0;color:#d4e7d0;font-size:10px}
@media(max-width:700px){#hud{padding:calc(env(safe-area-inset-top) + 12px) 12px 0}.logo{font-size:12px}.logo small{font-size:6px}.pill{font-size:8px;padding:6px}.hud-right{gap:3px}#mission{top:calc(env(safe-area-inset-top) + 57px);font-size:8px;padding:7px}#bottom{bottom:calc(env(safe-area-inset-bottom) + 108px);padding:0 17px}.meterbox{width:150px}.meter-label,.bagline{font-size:8px}.meter{height:14px}.actions{gap:4px}.gamebtn{height:37px;min-width:41px;font-size:7px;padding:2px 4px}.gamebtn span{font-size:13px;line-height:14px}#touch{display:block}.panel{padding:24px 18px}.panel h1{margin:13px 0 16px}.upgrades{gap:6px}.upgrade{padding:8px}.upgrade strong{font-size:10px}}
@media(max-height:550px){#bottom{bottom:calc(env(safe-area-inset-bottom) + 12px)}#touch{height:76px}.touchkey{width:56px;height:56px}.touchkey.action{width:65px;height:65px}.panel{max-height:94vh}}
#intro h1{font-size:clamp(40px,6vw,60px);line-height:1.04}
</style>
</head>
<body>
<canvas id="world" aria-label="Pixel art station"></canvas><div id="grain"></div><div id="vignette"></div><div id="screenFlash"></div><div id="toast"></div>
<header id="hud"><div class="logo">LAST LIGHT EXPRESS<small>A MIDNIGHT JOURNEY</small></div><div class="hud-right"><div class="pill" id="phase">AT THE TRAIN</div><div class="pill">✦ <b id="coins">0</b></div><div class="pill">NIGHT <b id="night">01</b></div></div></header>
<div id="mission">THE NEXT STATION IS WAITING</div>
<footer id="bottom"><div class="meterbox"><div class="meter-label"><span>◈ LANTERN CHARGE</span><span id="batteryText">100%</span></div><div class="meter"><i id="batteryFill"></i></div><div class="bagline">BAG <b id="bagCount">0 / 5</b> · <span id="cargoLabel">EMPTY</span></div></div><div class="actions"><button id="depart" class="gamebtn gold"><span>↗</span>DEPART</button><button id="return" class="gamebtn"><span>↩</span>RETURN</button><button id="upgradeBtn" class="gamebtn"><span>⚒</span>REPAIR</button></div></footer>
<div id="touch"><div class="touch-left"><button id="left" class="touchkey" aria-label="Move left">◀</button><button id="right" class="touchkey" aria-label="Move right">▶</button></div><div class="touch-right"><button id="dash" class="touchkey" aria-label="Dash">➤</button><button id="interact" class="touchkey action" aria-label="Collect">✦</button></div></div>
<section id="intro" class="overlay"><div class="panel"><div class="eyebrow">A PIXEL ADVENTURE AFTER DARK</div><h1>LAST LIGHT<br><em>EXPRESS</em></h1><p>The last train crosses a city swallowed by rain. Search its forgotten stations. Bring back lost parts. Give every carriage a new life.</p><button id="start" class="primary">BOARD THE TRAIN →</button><div class="hint">A / D OR ARROWS TO MOVE · E TO COLLECT · SPACE TO DASH<br>TOUCH CONTROLS ON MOBILE</div></div></section>
<section id="debrief" class="overlay hidden"><div class="panel"><div class="eyebrow" id="debriefEyebrow">NIGHT COMPLETE</div><h1>BACK<br><em>ON BOARD</em></h1><p id="runText"></p><div class="loot-summary" id="runLoot"></div><div class="divider"></div><div class="eyebrow">BUILD THE NEXT CAR</div><div class="upgrades" id="upgradeList"></div><p class="level-line" id="trainStatus"></p><button id="next" class="primary">NEXT STATION →</button></div></section>
<script src="midnight-rail.js?v=1"></script>
</body></html>
