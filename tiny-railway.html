<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#326d57"><meta name="description" content="A miniature railway puzzle where every delivery makes a town bloom."><title>TINY RAILWAY — A Town in Motion</title><link rel="stylesheet" href="tiny-railway.css"><script src="tiny-railway.js" defer></script></head>
<body><main class="game" aria-label="Tiny Railway route puzzle">
  <header class="top"><div class="brand"><small>A TOWN IN MOTION</small><h1>TINY <span>RAILWAY</span></h1></div><div class="top-buttons"><button id="sound" aria-label="Toggle sound" aria-pressed="true">♫</button><button id="pause" aria-label="Pause game" hidden>Ⅱ</button></div></header>
  <div class="hud"><div class="hud-box"><small>DAY</small><b id="day">01</b></div><div class="progress"><div class="progress-top"><span>DELIVERIES</span><strong id="deliveries">0 / 8</strong></div><div class="progress-track"><i id="progressFill"></i></div></div><div id="hearts" class="hearts" aria-label="3 chances left">♥ ♥ ♥</div></div>
  <section class="board" id="board" aria-label="Miniature railway map"><canvas id="scene" aria-hidden="true"></canvas>
    <div class="station station-rose" data-station="0"><span class="station-icon">✿</span><strong>ROSE</strong></div><div class="station station-lake" data-station="1"><span class="station-icon">◆</span><strong>LAKE</strong></div><div class="station station-sun" data-station="2"><span class="station-icon">☀</span><strong>SUN</strong></div><div class="station station-moss" data-station="3"><span class="station-icon">❋</span><strong>MOSS</strong></div>
    <button class="switch" id="switchL" data-switch="1" aria-label="Toggle left switch"><span>↖</span><small>TAP</small></button><button class="switch" id="switchR" data-switch="2" aria-label="Toggle right switch"><span>↖</span><small>TAP</small></button><button class="switch main-switch" id="switchA" data-switch="0" aria-label="Toggle main switch"><span>↖</span><small>TAP</small></button><div class="depot"><span>▤</span><small>DEPOT</small></div>
    <div class="board-tip" id="boardTip">TAP THE GOLD SWITCHES TO ROUTE EACH TRAIN</div>
  </section>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <footer class="bottom"><div class="ticket"><div><small>ROUTE TO</small><strong id="nextName">ROSE</strong></div><span id="nextIcon">✿</span></div><div class="hint"><span class="hint-dot"></span><span id="hint">MATCH EACH TRAIN TO ITS STATION</span></div><div class="best">BEST <b id="best">0</b></div></footer>
  <section class="overlay" id="overlay" aria-label="Game menu"><div class="menu"><div class="menu-kicker" id="menuKicker">A MINIATURE ROUTE PUZZLE</div><div class="menu-icon">✦<span class="loco"><i class="loco-stack"></i><i class="loco-window"></i><i class="loco-wheel wheel-a"></i><i class="loco-wheel wheel-b"></i></span>✦</div><h2 id="menuTitle">Make the<br>town bloom.</h2><p id="menuCopy">Tap the golden switches.<br>Guide each train to its matching station.</p><div class="menu-key"><span>✿ ROSE</span><span>◆ LAKE</span><span>☀ SUN</span><span>❋ MOSS</span></div><button id="start">ALL ABOARD <span>↗</span></button><small class="menu-note">EVERY DELIVERY CHANGES THE TOWN</small></div></section>
</main></body></html>
