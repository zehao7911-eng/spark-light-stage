function fail(error){const el=document.getElementById('loading');el.style.display='flex';el.style.opacity=1;el.querySelector('h2').textContent='The town needs a moment';document.getElementById('loadText').textContent=error?.message||'Please try opening in Safari or Chrome.';document.getElementById('retry').hidden=false;document.getElementById('retry').onclick=()=>location.reload()}let watchdog=setTimeout(()=>fail(new Error('Loading is taking longer than expected. Check your connection, then tap Try again.')),45000);import('./dustwood-app.js').then(()=>clearTimeout(watchdog)).catch(e=>{clearTimeout(watchdog);fail(e)});
